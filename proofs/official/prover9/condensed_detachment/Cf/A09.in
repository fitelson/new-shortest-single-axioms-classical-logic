formulas(assumptions).
-t(X) | -t(i(X,Y)) | t(Y) # label(condensed_detachment).
t(i(i(i(P,Q),i(R,S)),i(i(S,i(i(f,T),P)),i(R,P)))) # label(A09_Cf).
end_of_list.

