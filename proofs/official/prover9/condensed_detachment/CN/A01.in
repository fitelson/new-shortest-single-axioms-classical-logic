% Complete-basis Prover9 proof replay for axiom A1

set(raw).
set(hyper_resolution).
set(prolog_style_variables).
set(input_sos_first).
set(breadth_first_hints).
assign(max_weight, 0).
assign(max_proofs, 1).

formulas(assumptions).
-t(X) | -t(i(X,Y)) | t(Y) # label(condensed_detachment).
t(i(i(P,i(i(n(P),Q),R)),i(S,i(i(n(T),i(R,T)),i(P,T))))) # label(A01_CN).
end_of_list.

formulas(goals).
    (t(i(i(P,Q),i(i(Q,R),i(P,R)))) &
        t(i(i(n(P),P),P)) &
        t(i(P,i(n(P),Q)))).
end_of_list.

formulas(hints).
t(i(i(A,i(i(n(A),B),C)),i(D,i(i(n(E),i(C,E)),i(A,E))))). % CD proof line 1
t(i(A,i(i(n(B),i(i(i(n(C),i(D,C)),i(E,C)),B)),i(i(E,i(i(n(E),F),D)),B)))). % CD proof line 2
