% Complete-basis Prover9 proof replay for axiom A4

set(raw).
set(hyper_resolution).
set(prolog_style_variables).
set(input_sos_first).
set(breadth_first_hints).
assign(max_weight, 0).
assign(max_proofs, 1).

formulas(assumptions).
-t(X) | -t(i(X,Y)) | t(Y) # label(condensed_detachment).
t(i(P,i(i(n(Q),i(i(n(R),S),i(T,Q))),i(i(R,T),i(R,Q))))) # label(A04_CN).
end_of_list.

